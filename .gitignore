# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Raw video masters. Camera originals are hundreds of megabytes — far past
# GitHub's 100MB hard limit — and only the transcoded web versions in
# public/videos/*.mp4 are ever served. Keep the masters out of the repo.
/public/videos/*.mov
/public/videos/*.MOV
/public/videos/*.mp4.original

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev server output
.dev.log
